generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailContact {
  id          String   @id @default(cuid())
  email       String   @default("")
  displayName String   @default("")
  salutation  String   @default("")
  language    String   @default("en")
  company     String   @default("")
  mediaName   String   @default("")
  role        String   @default("")
  country     String   @default("")
  tags        String[] @default([])
  notes       String   @default("")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@map("email_contacts")
}

model EmailSender {
  id              String   @id @default(cuid())
  displayName     String   @default("")
  email           String   @unique
  workspaceKey    String   @default("default")
  teamKey         String   @default("outreach")
  domain          String   @default("")
  domainVerified  Boolean  @default(false)
  senderVerified  Boolean  @default(false)
  status          String   @default("inactive")
  mailboxAccountId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       OutreachWorkspace @relation(fields: [workspaceKey], references: [key], onDelete: Restrict)
  team            OutreachTeam @relation(fields: [workspaceKey, teamKey], references: [workspaceKey, key], onDelete: Restrict)
  mailboxAccount  EmailMailboxAccount? @relation(fields: [mailboxAccountId], references: [id], onDelete: SetNull)

  @@index([domain])
  @@index([workspaceKey, teamKey])
  @@index([status])
  @@index([mailboxAccountId])
  @@map("email_senders")
}

model OutreachWorkspace {
  key         String   @id
  name        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teams       OutreachTeam[]
  members     OutreachMember[]
  senders     EmailSender[]

  @@map("outreach_workspaces")
}

model OutreachTeam {
  id           String   @id @default(cuid())
  workspaceKey String
  key          String
  name         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    OutreachWorkspace @relation(fields: [workspaceKey], references: [key], onDelete: Cascade)
  members      OutreachMember[]
  senders      EmailSender[]

  @@unique([workspaceKey, key])
  @@index([workspaceKey])
  @@map("outreach_teams")
}

model OutreachMember {
  id           String   @id @default(cuid())
  workspaceKey String
  teamKey      String
  actorKey     String
  role         String   @default("viewer")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    OutreachWorkspace @relation(fields: [workspaceKey], references: [key], onDelete: Cascade)
  team         OutreachTeam @relation(fields: [workspaceKey, teamKey], references: [workspaceKey, key], onDelete: Cascade)

  @@unique([workspaceKey, teamKey, actorKey])
  @@index([actorKey, status])
  @@map("outreach_members")
}

model EmailDomainVerification {
  id            String   @id @default(cuid())
  workspaceKey  String
  teamKey       String
  domain        String
  method        String   @default("dns_txt")
  status        String   @default("unverified")
  token         String
  requestedAt   DateTime?
  lastCheckedAt DateTime?
  verifiedAt    DateTime?
  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceKey, teamKey, domain])
  @@index([workspaceKey, teamKey, status])
  @@map("email_domain_verifications")
}

model EmailMailboxAccount {
  id                 String    @id @default(cuid())
  workspaceKey       String    @default("default")
  provider           String    @default("tencent_enterprise_mail")
  mailboxEmail       String    @unique
  smtpHost           String
  smtpPort           Int       @default(465)
  smtpSecure         Boolean   @default(true)
  status             String    @default("inactive")
  verificationStatus String    @default("unverified")
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  senders            EmailSender[]

  @@index([workspaceKey, status])
  @@index([verificationStatus])

  @@map("email_mailbox_accounts")
}

model EmailTemplate {
  id          String   @id @default(cuid())
  templateKey String   @default("")
  version     Int      @default(1)
  isCurrent   Boolean  @default(true)
  name        String
  description String   @default("")
  subject     String
  bodyHtml    String
  language    String   @default("en")
  purpose     String   @default("")
  tags        String[] @default([])
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([updatedAt])
  @@index([templateKey, isCurrent])
  @@unique([templateKey, version])
  @@map("email_templates")
}

model EmailCampaign {
  id           String                  @id @default(cuid())
  idempotencyKey String?               @unique
  name         String
  subject      String
  bodyHtml     String
  senderId     String?
  senderEmail  String
  senderName   String
  replyToEmail String
  totalCount   Int                     @default(0)
  successCount Int                     @default(0)
  failedCount  Int                     @default(0)
  cancelledCount Int                   @default(0)
  repliedCount Int                     @default(0)
  status       String                  @default("draft")
  simulationFailureRecipient String?
  createdAt    DateTime                @default(now())
  sentAt       DateTime?
  deliveries   EmailCampaignDelivery[]
  retries      EmailCampaignRetry[]
  auditLogs    EmailCampaignAuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("email_campaigns")
}

model EmailCampaignDraft {
  id           String   @id @default(cuid())
  workspaceKey String   @unique @default("default")
  campaignName String
  draftTitle   String
  subject      String
  bodyHtml     String
  senderId     String?
  replyToEmail String   @default("")
  recipientRows Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
  @@map("email_campaign_drafts")
}

model EmailCampaignDelivery {
  id                String        @id @default(cuid())
  campaignId        String
  campaign          EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId         String?
  toEmail           String
  renderedSubject   String
  renderedBodyHtml  String
  renderedBodyText  String
  salutation        String        @default("")
  sendStatus        String        @default("pending")
  providerMessageId String?
  errorMessage      String?
  attemptCount      Int           @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  auditLogs         EmailCampaignAuditLog[]

  @@index([campaignId])
  @@index([sendStatus])
  @@index([toEmail])
  @@index([campaignId, sendStatus, createdAt])
  @@map("email_campaign_deliveries")
}

model EmailCampaignRetry {
  id             String        @id @default(cuid())
  campaignId     String
  campaign       EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  idempotencyKey String        @unique
  status         String        @default("sending")
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  @@index([campaignId])
  @@index([status])
  @@map("email_campaign_retries")
}

model EmailCampaignAuditLog {
  id         String                  @id @default(cuid())
  campaignId String?
  campaign   EmailCampaign?          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliveryId String?
  delivery   EmailCampaignDelivery?  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  action     String
  actor      String                  @default("operator")
  details    Json?
  createdAt  DateTime                @default(now())

  @@index([campaignId, createdAt])
  @@index([deliveryId, createdAt])
  @@index([action, createdAt])
  @@map("email_campaign_audit_logs")
}

model EmailSendRateLimit {
  key           String   @id
  nextAllowedAt DateTime @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@map("email_send_rate_limits")
}
