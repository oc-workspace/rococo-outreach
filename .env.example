NODE_ENV=production
PORT=3000
HOST_PORT=3107
NEXT_PUBLIC_APP_NAME=Rococo Outreach
NEXT_PUBLIC_OUTREACH_ENV=dev

POSTGRES_USER=rococo_outreach_user

POSTGRES_PASSWORD=change-me

POSTGRES_DB=rococo_outreach

DATABASE_URL=postgresql://rococo_outreach_user:change-me@postgres:5432/rococo_outreach?schema=public

# Tencent enterprise mailbox SMTP. Use an authorization code or app password,
# never the employee's interactive login password.
TENCENT_MAIL_SMTP_HOST=smtp.exmail.qq.com
TENCENT_MAIL_SMTP_PORT=465
TENCENT_MAIL_SMTP_SECURE=true
TENCENT_MAIL_SMTP_USER=employee@example.com
TENCENT_MAIL_SMTP_PASSWORD=replace-with-secret
TEST_RECIPIENT_EMAIL=controlled-recipient@example.com

# The SMTP test endpoint is disabled unless this server-only token is set.
SMTP_TEST_API_TOKEN=
SMTP_TEST_VERIFY_INTERVAL_SECONDS=10
SMTP_TEST_SEND_INTERVAL_SECONDS=60
